{
  "experiment_id": "adaptive_dp",
  "description": "FedAvg + Convergence-Aware Adaptive Differential Privacy Controller. Phase 5 & 6.",
  "dataset": "cifar10",
  "model": "simple_cnn",
  "num_clients": 10,
  "num_rounds": 50,
  "local_epochs": 3,
  "learning_rate": 0.05,
  "batch_size": 32,
  "fraction_evaluate": 1.0,
  "differential_privacy": true,
  "dp_params": {
    "initial_noise_multiplier": 0.5,
    "initial_max_grad_norm": 1.2,
    "target_delta": 1e-5
  },
  "adaptive_privacy": true,
  "controller_params": {
    "alpha": 0.10,
    "beta": 0.08,
    "threshold_high": 0.05,
    "threshold_low": 0.01,
    "noise_min": 0.3,
    "noise_max": 2.0,
    "epsilon_budget": 50.0,
    "warmup_rounds": 5
  },
  "secure_aggregation": false,
  "seed": 42
}
