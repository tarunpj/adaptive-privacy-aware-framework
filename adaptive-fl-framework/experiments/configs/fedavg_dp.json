{
  "experiment_id": "fedavg_dp",
  "description": "FedAvg + Fixed Differential Privacy (Opacus). Phase 2.",
  "dataset": "cifar10",
  "model": "simple_cnn",
  "num_clients": 10,
  "num_rounds": 50,
  "local_epochs": 3,
  "learning_rate": 0.05,
  "batch_size": 32,
  "fraction_evaluate": 1.0,
  "differential_privacy": true,
  "dp_params": {
    "noise_multiplier": 0.5,
    "max_grad_norm": 1.2,
    "target_delta": 1e-5
  },
  "secure_aggregation": false,
  "adaptive_privacy": false,
  "seed": 42
}
